generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * |------------------------------------------------------------------Ï--------
 * | ENUM
 * |--------------------------------------------------------------------------
 */

enum UserRole {
  ADMIN
  STORE
}

enum ProductStatus {
  ACTIVE
  SOLD
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ProductHistoryAction {
  CREATE
  UPDATE
  DELETE
  IMPORT
  PRICE_CHANGE
  STATUS_CHANGE
}

enum ImportRowStatus {
  SUCCESS
  ERROR
  SKIPPED
}

/**
 * |--------------------------------------------------------------------------
 * | USER
 * |--------------------------------------------------------------------------
 */

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String

  role UserRole @default(STORE)

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  // 作成した商品
  createdProducts Product[] @relation("ProductCreatedUser")

  // 更新した商品
  updatedProducts Product[] @relation("ProductUpdatedUser")

  // 削除した商品
  deletedProducts Product[] @relation("ProductDeletedUser")

  // 商品履歴
  productHistories ProductHistory[] @relation("ProductHistoryUser")

  // Excel取込
  importJobs ImportJob[] @relation("ImportExecutedUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * |--------------------------------------------------------------------------
 * | SHOP
 * |--------------------------------------------------------------------------
 */

model Shop {
  id String @id @default(uuid())

  name    String
  email   String?
  phone   String?
  address String?

  isActive Boolean @default(true)

  users User[]

  products Product[]

  importJobs ImportJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * |--------------------------------------------------------------------------
 * | PRODUCT
 * |--------------------------------------------------------------------------
 */

model Product {
  id String @id @default(uuid())

  // -------------------------
  // 店舗
  // -------------------------
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  // -------------------------
  // 作成者・更新者・削除者
  // -------------------------
  createdById String?
  createdBy   User?   @relation("ProductCreatedUser", fields: [createdById], references: [id])

  updatedById String?
  updatedBy   User?   @relation("ProductUpdatedUser", fields: [updatedById], references: [id])

  deletedById String?
  deletedBy User? @relation("ProductDeletedUser", fields: [deletedById], references: [id])

  // -------------------------
  // 商品情報
  // -------------------------
  productCode String
  title       String

  makerId String
  maker   Maker  @relation(fields: [makerId], references: [id])

  gradeId String?
  grade   Grade?  @relation(fields: [gradeId], references: [id])

  rankId String?
  rank   Rank?   @relation(fields: [rankId], references: [id])

  periodId String?
  period   Period? @relation(fields: [periodId], references: [id])

  traditionId String?
  tradition   Tradition? @relation(fields: [traditionId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  appraiserId String?
  appraiser   Appraiser? @relation(fields: [appraiserId], references: [id])

  price Int

  bladeLength Decimal? @db.Decimal(5, 2)
  curvature   Decimal? @db.Decimal(4, 2)

  salesDestination String?

  status ProductStatus @default(ACTIVE)

  listedAt DateTime?
  soldAt   DateTime?

  histories      ProductHistory[]
  priceHistories PriceHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, productCode])
}

/**
 * |--------------------------------------------------------------------------
 * | PRODUCT HISTORY
 * |--------------------------------------------------------------------------
 */

model ProductHistory {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  action ProductHistoryAction

  changedById String?
  changedBy   User?   @relation("ProductHistoryUser", fields: [changedById], references: [id])

  oldValue Json?

  newValue Json?

  createdAt DateTime @default(now())
}

/**
 * |--------------------------------------------------------------------------
 * | PRICE HISTORY
 * |--------------------------------------------------------------------------
 */

model PriceHistory {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  oldPrice Int?

  newPrice Int

  changedAt DateTime @default(now())
}

/**
 * |--------------------------------------------------------------------------
 * | IMPORT JOB
 * |--------------------------------------------------------------------------
 */

model ImportJob {
  id String @id @default(uuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  fileName String

  status ImportStatus @default(PENDING)

  totalRows Int @default(0)

  successRows Int @default(0)

  errorRows Int @default(0)

  rows ImportRow[]

  executedById String
  executedBy   User   @relation("ImportExecutedUser", fields: [executedById], references: [id])

  startedAt DateTime?

  completedAt DateTime?

  createdAt DateTime @default(now())
}

/**
 * |--------------------------------------------------------------------------
 * | IMPORT ROW
 * |--------------------------------------------------------------------------
 */

model ImportRow {
  id String @id @default(uuid())

  importJobId String
  importJob   ImportJob @relation(fields: [importJobId], references: [id])

  rowNumber Int

  productCode String?

  status ImportRowStatus @default(SKIPPED)

  message String?

  createdAt DateTime @default(now())
}

/**
 * |--------------------------------------------------------------------------
 * | MAKER
 * |--------------------------------------------------------------------------
 */

model Maker {
  id String @id @default(uuid())

  name String @unique

  displayOrder Int @default(0)

  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * |--------------------------------------------------------------------------
 * | GRADE
 * |--------------------------------------------------------------------------
 */

model Grade {
  id String @id @default(uuid())

  name String @unique

  displayOrder Int @default(0)

  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * |--------------------------------------------------------------------------
 * | RANK
 * |--------------------------------------------------------------------------
 */

model Rank {
  id String @id @default(uuid())

  name String @unique

  displayOrder Int @default(0)

  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * |--------------------------------------------------------------------------
 * | PERIOD
 * |--------------------------------------------------------------------------
 */

model Period {
  id String @id @default(uuid())

  name String @unique

  displayOrder Int @default(0)

  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * |--------------------------------------------------------------------------
 * | TRADITION
 * |--------------------------------------------------------------------------
 */

model Tradition {
  id String @id @default(uuid())

  name String @unique

  displayOrder Int @default(0)

  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * |--------------------------------------------------------------------------
 * | CATEGORY
 * |--------------------------------------------------------------------------
 */

model Category {
  id String @id @default(uuid())

  name String @unique

  displayOrder Int @default(0)

  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * |--------------------------------------------------------------------------
 * | APPRAISER
 * |--------------------------------------------------------------------------
 */

model Appraiser {
  id String @id @default(uuid())

  name String @unique

  displayOrder Int @default(0)

  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
